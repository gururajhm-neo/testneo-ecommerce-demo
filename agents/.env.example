# TestNeo Ecom Agents — environment template
# Copy to agents/.env and fill secrets. Never commit agents/.env.

# --- Ecom under test ---
ECOM_API_BASE=http://127.0.0.1:9000
ECOM_WEB_BASE=http://127.0.0.1:3001
ECOM_EMAIL=john@test.com
ECOM_PASSWORD=john123

# --- Agent runtime ---
# deterministic = reliable demo/CI (recommended default)
# crewai        = optional LLM narrator (needs GROQ_API_KEY or OPENAI_API_KEY)
AGENT_RUNTIME=deterministic
CREW_DEMO_MODE=normal
# CREW_LLM_MODEL=openai/llama-3.3-70b-versatile
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- TestNeo ---
TESTNEO_BASE_URL=http://localhost:8001
TESTNEO_WEB_APP_URL=http://localhost:5173
TESTNEO_API_KEY=tn_YOUR_KEY
TESTNEO_PROJECT_ID=15

# Suite loop on post-agent-gate
SUITE_TAGS=agent-verification,agent-checkout,agent-refund
SUITE_USE_AGENT=true
SUITE_FAILURE_BLOCKS_GATE=false
RUN_MAPPED_TESTS=true
QUEUE_EXECUTION=true
WAIT_FOR_SUITE=false
